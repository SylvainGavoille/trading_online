project_id                    = "sylvain-488510"
region                        = "us-central1"
bucket_name                   = "your-unique-quantum-ml-bucket"
container_image               = "us-central1-docker.pkg.dev/sylvain-488510/quantum/quantum-ml:latest"

# Every weekday at 22:20 New York time (after US market close)
scheduler_cron                = "20 22 * * 1-5"
scheduler_time_zone           = "America/New_York"

# Pipeline runtime tuning
price_refresh_days            = 7
price_backfill_days           = 365
pipeline_lookback_days        = 365
pipeline_horizons             = [5, 10]
pipeline_categories           = ["long_premium"]
pipeline_topk                 = 3
pipeline_min_train_days       = 80
pipeline_test_days            = 20
pipeline_step_days            = 20
pipeline_run_max_minutes      = 45
pipeline_lgbm_jobs            = 1

# Optional split mode: refresh and heavy pipeline as separate jobs/schedules.
# split_jobs_enabled             = true
# refresh_scheduler_cron         = "20 22 * * 1-5"
# pipeline_scheduler_cron        = "50 22 * * 1-5"
# refresh_job_timeout_seconds    = 5400
# pipeline_job_timeout_seconds   = 10800
# refresh_job_cpu                = "2"
# refresh_job_memory             = "8Gi"
# pipeline_job_cpu               = "4"
# pipeline_job_memory            = "16Gi"

# Set to true when Cloud Run IP is rate-limited by Yahoo Finance (ok=0 vide=N)
skip_price_refresh            = true

job_timeout_seconds           = 7200
job_cpu                       = "2"
job_memory                    = "8Gi"
job_max_retries               = 1
